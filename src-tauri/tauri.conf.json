{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM E-Ink Dashboard",
  "version": "0.1.5",
  "identifier": "com.local.llm-eink-dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "LLM E-Ink Dashboard", "width": 1240, "height": 820, "minWidth": 960, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "macOS": { "minimumSystemVersion": "11.0" },
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
